# Copie para .env.local e preencha com as chaves do projeto Supabase
# (Project Settings > API no painel do Supabase).

# URL do projeto Supabase. Ex: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon key) — segura para expor no browser, o isolamento
# real vem das RLS policies do banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service role) — NUNCA expor no browser. Só usada em
# código server-only (ignora RLS). Não é necessária para o módulo de CRM
# desta fase; deixar em branco até que algum fluxo administrativo precise.
SUPABASE_SERVICE_ROLE_KEY=
